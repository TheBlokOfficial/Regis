[Unit]
Description=Regis-Core Fallback Worker
After=network.target regis.service

[Service]
Type=simple
User=theblok
WorkingDirectory=/home/theblok/regis
ExecStart=/home/theblok/regis/.venv/bin/uvicorn node.worker:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
